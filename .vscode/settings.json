{
    "python.defaultInterpreterPath": "${workspaceFolder}/venv_v2/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.terminal.activateEnvInCurrentTerminal": true,
    "terminal.integrated.env.linux": {
        "VIRTUAL_ENV": "${workspaceFolder}/venv_v2",
        "PATH": "${workspaceFolder}/venv_v2/bin:${env:PATH}"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.python",
        "editor.formatOnSave": true,
        "editor.rulers": [
            88,
            120
        ]
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.git": true,
        "**/.pytest_cache": true,
        "**/.venv": true,
        "**/env_oiolabot": true
    }
}