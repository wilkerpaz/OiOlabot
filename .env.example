# OiOlabot v2 — Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to git (contains secrets)

# Telegram API credentials (from https://my.telegram.org)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Bot tokens from BotFather (https://t.me/BotFather)
DEV_TOKEN=bot_token_for_main_bot
DEV_TOKEN_LD=bot_token_for_liturgy_bot

# Redis configuration
DB=0                           # Database for main bot (groups, RSS)
DB_LD=1                        # Database for liturgy bot (daily subscriptions)
REDIS_HOST=localhost           # Redis server host
REDIS_PORT=6379               # Redis server port
REDIS_PASSWORD=               # Leave empty if no password

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG=INFO

# Timezone for daily liturgy delivery (IANA format)
# Use America/Sao_Paulo for BRT (Brasília Time - UTC-3/-2)
TZ=America/Sao_Paulo

# Optional: Bot names for identification
BOT_NAME=oiolabot_main
BOT_NAME_LD=oiolabot_liturgy

# Optional: Group/Channel links to include in feed footers
# Format: https://t.me/group_username or @group_username
GROUP_LINK=https://t.me/SejaBemVindo
GROUP_LINK_LD=https://t.me/EvangelhodoDia
